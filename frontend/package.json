{
  "type": "module",
  "scripts": {
    "check:three-async": "node scripts/check-three-async.mjs",
    "check:bundle": "size-limit && node scripts/check-three-async.mjs"
  },
  "size-limit": [
    {
      "name": "three chunk (async, Landing hero only)",
      "path": "dist/assets/three-*.js",
      "limit": "220 KB",
      "gzip": true
    },
    {
      "name": "index (initial route — must not grow from the three work)",
      "path": "dist/assets/index-*.js",
      "limit": "114 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/sora": "^5.2.8",
    "emoji-picker-element": "^1.29.1",
    "maplibre-gl": "^5.24.0",
    "svelte": "^5.51.2",
    "svelte-spa-router": "^4.0.2",
    "tesseract.js": "^5.1.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@size-limit/file": "^11.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "culori": "^4.0.2",
    "size-limit": "^11.2.0",
    "vite": "^8.1.3",
    "vite-plugin-compression2": "^2.5.3"
  }
}
