# One block per project. Caddy auto-provisions Let's Encrypt TLS for each host
# and transparently proxies WebSocket upgrades. The proxy target is the app's
# container_name + internal port (both must be on the `web` docker network).

kinnect.duckdns.org {
	encode gzip zstd
	reverse_proxy kinnect-backend:3000
}

