# Copy to deploy/oracle/.env on the VM.  NEVER commit the real .env.
DOMAIN=kinnect.duckdns.org                 # this app's subdomain (must match edge/Caddyfile)
KINNECT_DB_PASSWORD=change-me-strong        # openssl rand -hex 24 (the per-app DB user password)
SESSION_SECRET=change-me-64-chars           # openssl rand -hex 32
ADMIN_EMAIL=you@example.com                 # first user with this email becomes admin
