# ── Stage 1: Build frontend ─────────────────────────────────────────
FROM node:20-slim AS frontend-builder
WORKDIR /app

# Layer 1: install deps (cached unless package*.json change)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
    && rm -rf node_modules/tesseract.js-core \
    && rm -rf node_modules/@capacitor/android \
    && rm -rf node_modules/@capacitor/cli

# Layer 2: build (only re-runs when frontend source changes)
COPY frontend/ ./frontend/
RUN VITE_TARGET=web npm run build:frontend

# ── Stage 2: Build Go backend (runs in parallel with stage 1) ──────
FROM golang:1.25-alpine AS backend-builder
WORKDIR /build
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o server .

# ── Stage 3: Minimal runtime image ─────────────────────────────────
FROM alpine:3.19
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=backend-builder /build/server .
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist
ENV FRONTEND_DIR=/app/frontend/dist PORT=3000
EXPOSE 3000
CMD ["./server"]
